    "section": "#### 9.23.2 损益结构",
    "scenarios": [
      {
        "id": "9.23.2-01",
        "title": "提前敲出",
        "condition": "某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$C$"
      },
      {
        "id": "9.23.2-02",
        "title": "未敲出、未敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且全程$S_t>H_{in}$",
        "payoff": "$C$"
      },
      {
        "id": "9.23.2-03",
        "title": "未敲出、曾敲入、到期不低于执行价",
        "condition": "全部敲出观察日$S_t<H_{out}$，曾敲入且$S_T\\ge K$",
        "payoff": "$C$"
      },
      {
        "id": "9.23.2-04",
        "title": "未敲出、曾敲入、到期低于执行价",
        "condition": "全部敲出观察日$S_t<H_{out}$，曾敲入且$S_T<K$",
        "payoff": "$C+N\\cdot\\max(S_T/K-1,F-1)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
