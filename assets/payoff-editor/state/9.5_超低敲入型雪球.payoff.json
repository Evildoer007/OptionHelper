    "section": "#### 9.5.2 损益结构",
    "scenarios": [
      {
        "id": "9.5.2-01",
        "title": "提前敲出",
        "condition": "任一敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.5.2-02",
        "title": "未敲出、未敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且全程未触及敲入线",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.5.2-03",
        "title": "未敲出、曾敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且曾触及敲入线",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
