    "section": "#### 9.18.2 损益结构",
    "scenarios": [
      {
        "id": "9.18.2-01",
        "title": "提前敲出",
        "condition": "存在某个敲出观察日，使该日$P_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$，产品提前终止"
      },
      {
        "id": "9.18.2-02",
        "title": "未敲出、未敲入",
        "condition": "全部敲出观察日$P_t<H_{out}$，且全部敲入观察节点$P_t>H_{in}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.18.2-03",
        "title": "未敲出、曾敲入、到期修复",
        "condition": "全部敲出观察日$P_t<H_{out}$，曾有$P_t\\le H_{in}$，且$P_T\\ge 100\\%$",
        "payoff": "通常为0；若合同约定修复给息，则按合同给付"
      },
      {
        "id": "9.18.2-04",
        "title": "未敲出、曾敲入、到期未修复",
        "condition": "全部敲出观察日$P_t<H_{out}$，曾有$P_t\\le H_{in}$，且$P_T<100\\%$",
        "payoff": "$N\\cdot (P_T-100\\%)$，为负值；等价于损失$N\\cdot (1-P_T)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
