        "id": "9.10.2-01",
        "title": "常规提前敲出",
        "condition": "非最后观察日$S_t\\ge103\\%\\cdot S_0$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.10.2-02",
        "title": "最后观察日敲出",
        "condition": "最后观察日$S_T\\ge70\\%\\cdot S_0$，且此前未敲出",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.10.2-03",
        "title": "未敲出、曾敲入",
        "condition": "全部非最后敲出观察日$S_t<103\\%\\cdot S_0$，曾敲入且最后观察日$S_T<70\\%\\cdot S_0$",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
