    "section": "#### 9.14.2 损益结构",
    "scenarios": [
      {
        "id": "9.14.2-01",
        "title": "未敲入后提前敲出",
        "condition": "未发生敲入，且某个敲出观察日$S_t\\ge100\\%\\cdot S_0$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.14.2-02",
        "title": "曾敲入后重置敲出",
        "condition": "曾发生敲入，重置后某个观察日$S_t\\ge90\\%\\cdot S_0$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.14.2-03",
        "title": "未敲出且未敲入",
        "condition": "全部敲出观察日未达敲出线，且未发生敲入",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.14.2-04",
        "title": "曾敲入且未敲出",
        "condition": "曾发生敲入，重置后仍未敲出",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
