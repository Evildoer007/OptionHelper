    "section": "#### 9.4.2 损益结构",
    "scenarios": [
      {
        "id": "9.4.2-01",
        "title": "未敲入后提前敲出",
        "condition": "尚未敲入，且某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.4.2-02",
        "title": "未敲出且未敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且全部敲入观察日$S_t>H_{in}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.4.2-03",
        "title": "曾敲入",
        "condition": "曾有$S_t\\le H_{in}$，此后不再观察敲出",
        "payoff": "$N\\cdot\\frac{S_T-K}{K}$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
