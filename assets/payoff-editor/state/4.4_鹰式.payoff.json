    "section": "#### 4.4.2 损益结构",
    "scenarios": [
      {
        "id": "4.4.2-01",
        "title": "到期落在两端区间外",
        "condition": "$S_T\\le K_1$或$S_T\\ge K_4$",
        "payoff": "$-D$"
      },
      {
        "id": "4.4.2-02",
        "title": "到期落在第一与第二行权价之间",
        "condition": "$K_1<S_T<K_2$",
        "payoff": "$S_T-K_1-D$"
      },
      {
        "id": "4.4.2-03",
        "title": "到期落在第二与第三行权价之间",
        "condition": "$K_2\\le S_T\\le K_3$",
        "payoff": "($K_2-K_1)-D$"
      },
      {
        "id": "4.4.2-04",
        "title": "到期落在第三与第四行权价之间",
        "condition": "$K_3<S_T<K_4$",
        "payoff": "$K_4-S_T-D$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
