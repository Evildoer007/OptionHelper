    "section": "#### 9.9.2 损益结构",
    "scenarios": [
      {
        "id": "9.9.2-01",
        "title": "提前敲出",
        "condition": "存在第$j$个敲出观察日$S_t\\ge H_{out,j}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.9.2-02",
        "title": "未敲出、未敲入",
        "condition": "所有敲出观察日均低于对应$H_{out,j}$，且未发生敲入",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.9.2-03",
        "title": "未敲出、曾敲入",
        "condition": "所有敲出观察日均低于对应$H_{out,j}$，且曾发生敲入",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
