    "section": "#### 9.15.2 损益结构",
    "scenarios": [
      {
        "id": "9.15.2-01",
        "title": "正常提前敲出",
        "condition": "任一敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.15.2-02",
        "title": "避险提前结束",
        "condition": "未敲入、尚未敲出，且某个避险观察日$S_t$低于对应避险线",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.15.2-03",
        "title": "未敲出、未敲入、未避险",
        "condition": "存续期内未触发敲出、敲入或避险",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.15.2-04",
        "title": "未敲出、曾敲入、未避险",
        "condition": "曾敲入且未触发约定避险结束",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
