    "section": "#### 9.11.2 损益结构",
    "scenarios": [
      {
        "id": "9.11.2-01",
        "title": "提前敲出",
        "condition": "存在某个敲出观察日，使$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot\\left[y\\cdot\\frac{\\text{实际持有天数}}{365}+a\\cdot\\frac{S_t-H_{out}}{S_0}\\right]$，产品提前终止"
      },
      {
        "id": "9.11.2-02",
        "title": "未敲出、未敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且全部敲入观察节点$S_t>H_{in}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.11.2-03",
        "title": "未敲出、曾敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且曾有$S_t\\le H_{in}$",
        "payoff": "$N\\cdot \\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
