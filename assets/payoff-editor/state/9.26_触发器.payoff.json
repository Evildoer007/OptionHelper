    "section": "#### 9.26.2 损益结构",
    "scenarios": [
      {
        "id": "9.26.2-01",
        "title": "触发提前赎回",
        "condition": "某个观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot q$"
      },
      {
        "id": "9.26.2-02",
        "title": "未触发、未敲入",
        "condition": "全部观察日未达$H_{out}$，且全程$S_t>H_{in}$",
        "payoff": "$N\\cdot y_T$"
      },
      {
        "id": "9.26.2-03",
        "title": "未触发、曾敲入、到期修复",
        "condition": "全部观察日未达$H_{out}$，曾敲入且$S_T\\ge K$",
        "payoff": "$0$或合同约定的到期票息"
      },
      {
        "id": "9.26.2-04",
        "title": "未触发、曾敲入、到期未修复",
        "condition": "全部观察日未达$H_{out}$，曾敲入且$S_T<K$",
        "payoff": "$N\\cdot(S_T/K-1)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
