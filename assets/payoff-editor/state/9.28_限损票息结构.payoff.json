        "id": "9.28.2-01",
        "title": "提前敲出",
        "condition": "某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.28.2-02",
        "title": "未敲出、到期不跌",
        "condition": "未发生提前敲出，且$S_T\\ge S_0$",
        "payoff": "$0$"
      },
      {
        "id": "9.28.2-03",
        "title": "未敲出、到期跌幅未触及限损",
        "condition": "未发生提前敲出，且$(1-L)S_0\\le S_T<S_0$",
        "payoff": "$N\\cdot R$"
      },
      {
        "id": "9.28.2-04",
        "title": "未敲出、到期跌幅触及限损",
        "condition": "未发生提前敲出，且$S_T<(1-L)S_0$",
        "payoff": "$N\\cdot\\max(R,-L)$"
      }
    ],
