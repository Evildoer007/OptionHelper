    "section": "#### 9.3.2 损益结构",
    "scenarios": [
      {
        "id": "9.3.2-01",
        "title": "提前敲出",
        "condition": "存在某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.3.2-02",
        "title": "未敲出、未敲入",
        "condition": "全部敲出观察日$S_t<H_{out}$，且全部敲入观察日$S_t>H_{in}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.3.2-03",
        "title": "未敲出、曾敲入、到期不低于执行价",
        "condition": "全部敲出观察日$S_t<H_{out}$，曾有$S_t\\le H_{in}$，且$S_T\\ge K$",
        "payoff": "$0$"
      },
      {
        "id": "9.3.2-04",
        "title": "未敲出、曾敲入、到期低于执行价",
        "condition": "全部敲出观察日$S_t<H_{out}$，曾有$S_t\\le H_{in}$，且$S_T<K$",
        "payoff": "$N\\cdot\\frac{S_T-K}{K}$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
  },
