    "section": "#### 9.12.2 损益结构",
    "scenarios": [
      {
        "id": "9.12.2-01",
        "title": "第一年提前敲出",
        "condition": "第一年某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y_1\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.12.2-02",
        "title": "第二年提前敲出",
        "condition": "第二年某个敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y_2\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.12.2-03",
        "title": "未敲出、未敲入",
        "condition": "未发生敲出和敲入",
        "payoff": "$N\\cdot y_2\\cdot\\frac{\\text{总期限天数}}{365}$"
      },
      {
        "id": "9.12.2-04",
        "title": "未敲出、曾敲入",
        "condition": "曾发生敲入但未敲出",
        "payoff": "$N\\cdot\\min((S_T-S_0)/S_0,0)$"
      }
    ],
    "axis": {
      "kind": "underlying_price",
      "label": "标的价格(%)",
      "unit": "%",
      "referenceValue": 100
    }
