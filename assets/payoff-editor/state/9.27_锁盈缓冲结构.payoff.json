        "title": "提前敲出",
        "condition": "某个非到期敲出观察日$S_t\\ge H_{out}$",
        "payoff": "$N\\cdot y\\cdot\\frac{\\text{实际持有天数}}{365}$"
      },
      {
        "id": "9.27.2-02",
        "title": "未敲出、到期高于缓冲价",
        "condition": "未发生提前敲出，且$S_T>B$",
        "payoff": "$N\\cdot\\frac{S_T-B}{S_0}$"
      },
      {
        "id": "9.27.2-03",
        "title": "未敲出、到期等于或低于缓冲价",
        "condition": "未发生提前敲出，且$S_T\\le B$",
        "payoff": "$N\\cdot\\left(\\frac{S_T}{S_0}-1\\right)$"
      }
    ],
