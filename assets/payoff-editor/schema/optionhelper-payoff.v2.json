{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optionhelper-payoff/v2",
  "title": "OptionHelper Payoff Draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "library", "graphics"],
  "properties": {
    "$schema": { "const": "optionhelper-payoff/v2" },
    "schemaVersion": { "const": 2 },
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "sourceFingerprint", "section", "scenarios", "axis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": "string", "minLength": 1 }, "section": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }, "axis": { "$ref": "#/$defs/axis" }
      }
    },
    "graphics": { "type": "array", "items": { "$ref": "#/$defs/graphic" } }
  },
  "$defs": {
    "number": { "type": "number", "multipleOf": 0.01 },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "condition", "payoff"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "condition": { "type": "string", "minLength": 1 }, "payoff": { "type": "string", "minLength": 1 } }
    },
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["kind", "label", "unit", "referenceValue"],
      "properties": { "kind": { "enum": ["underlying_price", "realized_volatility", "observed_days", "coupon_count"] }, "label": { "type": "string", "minLength": 1 }, "unit": { "type": "string" }, "referenceValue": { "$ref": "#/$defs/number" } }
    },
    "scale": {
      "type": "object", "additionalProperties": false, "required": ["xMin", "xMax", "yMin", "yMax"],
      "properties": { "xMin": { "$ref": "#/$defs/number" }, "xMax": { "$ref": "#/$defs/number" }, "yMin": { "$ref": "#/$defs/number" }, "yMax": { "$ref": "#/$defs/number" } }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "$ref": "#/$defs/number" }, "y": { "$ref": "#/$defs/number" }, "breakBefore": { "type": "boolean" }, "endpoint": { "enum": ["none", "open", "closed"] } }
    },
    "curve": {
      "type": "object", "additionalProperties": false, "required": ["type", "strokeWidth", "points"],
      "properties": { "type": { "enum": ["polyline", "step"] }, "strokeWidth": { "type": "number", "minimum": 0.1, "maximum": 20, "multipleOf": 0.01 }, "points": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/point" } } }
    },
    "threshold": {
      "type": "object", "additionalProperties": false, "required": ["token", "value"],
      "properties": { "token": { "enum": ["S₀", "K", "K₁", "K₂", "K₃", "K₄", "K_p", "K_c", "K_u", "K_d", "H", "H_in", "H_{in,2}", "H_out", "H_{out,2}", "H_{out,t}", "H_c", "H_buffer", "H_floor", "H_reset", "H_u", "H_d", "H_{hedge,1}", "H_{hedge,2}", "B", "L"] }, "value": { "$ref": "#/$defs/number" } }
    },
    "guide": {
      "type": "object", "additionalProperties": false, "required": ["direction", "value", "style"],
      "properties": { "direction": { "enum": ["horizontal", "vertical"] }, "value": { "$ref": "#/$defs/number" }, "start": { "$ref": "#/$defs/number" }, "end": { "$ref": "#/$defs/number" }, "style": { "const": "dashed" } }
    },
    "graphic": {
      "type": "object", "additionalProperties": false, "required": ["scenarioId", "scale", "curve", "thresholds", "guides"],
      "properties": { "scenarioId": { "type": "string", "minLength": 1 }, "scale": { "$ref": "#/$defs/scale" }, "curve": { "$ref": "#/$defs/curve" }, "thresholds": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/threshold" } }, "guides": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/guide" } } }
    }
  }
}
