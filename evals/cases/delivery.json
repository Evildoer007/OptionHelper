[
  {
    "id": "reporter.status.dependencies",
    "area": "reporter",
    "description": "Reporter声明显式依赖及Card、Report、HTML、PDF契约",
    "target": "tool.call",
    "input": {"module": "reporter", "request": {"action": "status"}},
    "expect": {"equals": {"ok": true, "status": "requires_dependencies", "request_schema": "optionhelper.report-request/v2"}, "contains": {"formats": "html", "output_types": "card"}}
  },
  {
    "id": "reporter.run.no-store",
    "area": "reporter",
    "description": "未注入ResultStore时不得读取物理目录或伪造报告",
    "target": "tool.call",
    "input": {"module": "reporter", "request": {"action": "run"}},
    "expect": {"equals": {"ok": false, "error": "result_store_not_injected"}}
  },
  {
    "id": "reporter.path.rejected",
    "area": "reporter",
    "description": "Reporter拒绝调用方提供物理结果路径",
    "target": "tool.call",
    "input": {"module": "reporter", "request": {"action": "run", "result_dir": "/tmp/not-allowed"}},
    "expect": {"equals": {"ok": false, "status": "rejected"}, "contains": {"error": "result_dir"}}
  },
  {
    "id": "designer.status.offline-html",
    "area": "designer",
    "description": "Designer离线HTML能力可用且PDF被显式关闭",
    "target": "tool.call",
    "input": {"module": "designer", "request": {"action": "status", "config": {"allow_pdf": false}}},
    "expect": {"equals": {"ok": true, "status": "available"}, "contains": {"formats": "html", "output_types": "report"}}
  },
  {
    "id": "designer.render.report-html",
    "area": "designer",
    "description": "完整Report概念可渲染为离线HTML",
    "target": "tool.call",
    "input": {"module": "designer", "request": {"action": "render", "payload": "$DESIGNER_PAYLOAD", "output_type": "report", "format": "html", "html_report_layout": "continuous", "config": {"allow_pdf": false, "allow_portable_assets": true}}},
    "expect": {"equals": {"ok": true, "artifact.output_type": "report", "artifact.format": "html"}, "contains": {"artifact.html": "<!doctype html"}, "not_contains": {"artifact.html": "OptionHelper"}}
  },
  {
    "id": "designer.render.card-html",
    "area": "designer",
    "description": "简版Card概念可渲染为离线HTML",
    "target": "tool.call",
    "input": {"module": "designer", "request": {"action": "render", "payload": "$DESIGNER_PAYLOAD", "output_type": "card", "format": "html", "config": {"allow_pdf": false}}},
    "expect": {"equals": {"ok": true, "artifact.output_type": "card", "artifact.format": "html"}, "contains": {"artifact.html": "场外衍生品结构研究报告"}, "not_contains": {"artifact.html": "OptionHelper"}}
  },
  {
    "id": "designer.render.html-escape",
    "area": "designer",
    "description": "Designer把外部标题作为文本处理，不执行脚本标签",
    "target": "tool.call",
    "input": {"module": "designer", "request": {"action": "render", "payload": "$DESIGNER_PAYLOAD_WITH_SCRIPT", "output_type": "report", "format": "html", "config": {"allow_pdf": false}}},
    "expect": {"equals": {"ok": true}, "contains": {"artifact.html": "&lt;script&gt;"}, "not_contains": {"artifact.html": "<script>alert(1)</script>"}}
  },
  {
    "id": "designer.config.invalid",
    "area": "designer",
    "description": "非法配置返回结构化错误",
    "target": "tool.call",
    "input": {"module": "designer", "request": {"action": "status", "config": {"allow_pdf": "yes"}}},
    "expect": {"equals": {"ok": false, "status": "misconfigured", "error": "invalid_configuration"}}
  },
  {
    "id": "reporter.real.report-html",
    "area": "reporter",
    "description": "注入真实ResultStore与DesignerPort生成完整HTML Report",
    "target": "reporter.real_delivery",
    "input": {"output_type": "report"},
    "expect": {"equals": {"output_type": "report", "report_exists": true, "evidence_status": "partial"}, "contains": {"html": "<!doctype html"}, "exists": ["semantic_fact_hash"]}
  },
  {
    "id": "reporter.real.card-html",
    "area": "reporter",
    "description": "注入真实ResultStore与DesignerPort生成简版HTML Card",
    "target": "reporter.real_delivery",
    "input": {"output_type": "card"},
    "expect": {"equals": {"output_type": "card", "report_exists": true, "evidence_status": "partial"}, "contains": {"html": "000300.SH看涨期权推荐卡片"}, "not_contains": {"html": "OptionHelper"}, "exists": ["semantic_fact_hash"]}
  },
  {
    "id": "reporter.card-report.fact-equivalence",
    "area": "reporter",
    "description": "Card与Report只改变呈现层，冻结事实哈希保持一致",
    "target": "workflow.card_report_equivalence",
    "input": {},
    "expect": {"equals": {"equal": true}, "exists": ["report_hash", "card_hash"]}
  },
  {
    "id": "delivery.pdf.unavailable",
    "area": "delivery",
    "description": "Reporter可声明PDF概念，但当前Designer关闭PDF时必须诚实Unavailable",
    "target": "workflow.pdf_boundary",
    "input": {},
    "expect": {"contains": {"reporter_formats": "pdf"}, "equals": {"designer_pdf_available": false, "status": "unavailable"}}
  }
]
