  {
    "id": "knowledger.lookup.unknown",
    "area": "knowledger",
    "description": "未知产品不得被静默替换",
    "target": "knowledger.lookup",
    "input": {"product_id": "0.0"},
    "expect": {"equals": {"exception.type": "KeyError"}, "contains": {"exception.message": "未知产品"}}
  }
]
