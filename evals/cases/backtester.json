[
  {
    "id": "backtester.path.non-trigger",
    "area": "backtester",
    "description": "未触发敲出路径必须保留为有效非触发样本",
    "target": "backtester.regression",
    "input": {"scenario": "non_trigger"},
    "expect": {"equals": {"trade_count": 1, "triggered_count": 0, "untriggered_count": 1}}
  },
  {
    "id": "backtester.entry.non-trading-day",
    "area": "backtester",
    "description": "显式非交易日不得被自动平移为入场日",
    "target": "backtester.regression",
    "input": {"scenario": "non_trading_entry"},
    "expect": {"equals": {"exception_type": "ZeroValidSamplesError"}, "contains": {"message": "zero_valid_samples"}}
  },
  {
    "id": "backtester.multi-underlying.missing-history",
    "area": "backtester",
    "description": "多标的合同缺少任一标的历史时必须拒绝运行",
    "target": "backtester.regression",
    "input": {"scenario": "missing_multi_underlying"},
    "expect": {"equals": {"exception_type": "BacktestInputError"}, "contains": {"message": "000300.SH"}}
  }
