{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optionhelper.eval-case.v1",
  "title": "OptionHelper开发评测案例",
  "type": "object",
  "required": ["id", "area", "description", "target", "input", "expect"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "area": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "target": {
      "enum": [
        "tool.call",
        "knowledger.lookup",
        "authorization.check",
        "recommender.controlled",
        "reporter.real_delivery",
        "store.cross_tenant",
        "workflow.card_report_equivalence",
        "workflow.catalog_alignment",
        "workflow.knowledge_payoff",
        "workflow.delivery_contract",
        "workflow.pdf_boundary",
        "pricer.regression",
        "backtester.regression",
        "app.bridge_contract",
        "reporter.selection_protocol",
        "datafetcher.caller_context",
        "app.agent_runtime",
        "compute.formal_run",
        "compute.runref_v12",
        "modulehost.v2",
        "compute.security_matrix",
        "reporter.public_protocol",
        "recommender.evidence_matrix",
        "datafetcher.app_security",
        "app.agent_security_matrix",
        "workflow.formal_compute_protocol"
      ]
    },
    "input": {"type": "object"},
    "expect": {
      "type": "object",
      "properties": {
        "equals": {"type": "object"},
        "contains": {"type": "object"},
        "not_contains": {"type": "object"},
        "length": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "exists": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
