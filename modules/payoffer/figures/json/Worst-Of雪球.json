{
  "name_zh": "Worst-Of雪球",
  "terms": {
    "T": 1.0,
    "N": 10000000.0,
    "g": 0.3,
    "H_KO": 103.0,
    "H_KI": 70.0,
    "c": 0.225,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "S0Vec": [
      100.0,
      100.0
    ],
    "monitor": {
      "tau_out": "first_time(W_t[O_out] >= H_out)",
      "tau_in": "first_time(W_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "H_in < H_out"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "W_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "W_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "W_T >= 100",
          "pnl": "cash(T, 0)"
        },
        {
          "domain": "0 <= W_T < 100",
          "pnl": "cash(T, N * (W_T / 100 - 1))"
        }
      ]
    }
  ]
}
