{
  "name_zh": "高保底雪球",
  "terms": {
    "S0": 100.0,
    "T": 0.5,
    "N": 10000000.0,
    "g": 0.05,
    "H_KO": 103.0,
    "H_KI": 95.0,
    "c": 0.155,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "Llock": 1,
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "monitor": {
      "tau_out": "first_time_after(S_t[O_out] >= H_out, n_lock)",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g",
      "Hfloor": "H_in"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "H_in < H_out",
      "is_monthly_schedule(O_out)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= H_floor",
          "pnl": "cash(T, N * r_T)"
        },
        {
          "domain": "0 <= S_T < H_floor",
          "pnl": "cash(T, N * (H_floor / S_0 - 1))"
        }
      ]
    }
  ]
}
