{
  "name_zh": "凤凰式结构",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "N": 10000000.0,
    "g": 0.2,
    "K": 100.0,
    "H_KO": 100.0,
    "H_KI": 80.0,
    "c": 0.063,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "Llock": 1,
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "Hc": 80.0,
    "Oc": "monthly_last",
    "monitor": {
      "tau_out": "first_time_after(S_t[O_out] >= H_out, n_lock)",
      "tau_in": "first_time(S_t[O_in] <= H_in)",
      "n_coupon": "count_until(S_t[O_c] >= H_c, first_time_after(S_t[O_out] >= H_out, n_lock))"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K == S_0",
      "H_c == H_in",
      "H_in == 0.8 * S_0",
      "H_out == S_0",
      "n_lock < period_count(T, 12)",
      "is_monthly_schedule(O_out)",
      "is_monthly_schedule(O_c)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * n_coupon / 12)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * n_coupon / 12)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= K",
          "pnl": "cash(T, N * c * n_coupon / 12)"
        },
        {
          "domain": "0 <= S_T < K",
          "pnl": "cash(T, N * c * n_coupon / 12 + N * (S_T / K - 1))"
        }
      ]
    }
  ],
  "visual_template": {
    "schema": "optionhelper.payoff-visual-template",
    "layout": "standard_path_cards",
    "path_views": [
      {
        "path_index": 1,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径1"
      },
      {
        "path_index": 2,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径2"
      },
      {
        "path_index": 3,
        "case_indexes": [
          1,
          2
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径3"
      }
    ]
  }
}
