{
  "name_zh": "敲出递降型雪球",
  "terms": {
    "S0": 100.0,
    "T": 2.0,
    "N": 10000000.0,
    "g": 0.2,
    "K": 100.0,
    "H_KI": 70.0,
    "c": 0.19,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "derived_terms": {
      "G": "N * g",
      "ko_barrier_schedule": "[(1, 1.03 * S_0), (2, 1.025 * S_0), (3, 1.02 * S_0), (4, 1.015 * S_0), (5, 1.01 * S_0), (6, 1.005 * S_0), (7, S_0), (8, 0.995 * S_0), (9, 0.99 * S_0), (10, 0.985 * S_0), (11, 0.98 * S_0), (12, 0.975 * S_0), (13, 0.97 * S_0), (14, 0.965 * S_0), (15, 0.96 * S_0), (16, 0.955 * S_0), (17, 0.95 * S_0), (18, 0.945 * S_0), (19, 0.94 * S_0), (20, 0.935 * S_0), (21, 0.93 * S_0), (22, 0.925 * S_0), (23, 0.92 * S_0), (24, 0.915 * S_0)]"
    },
    "monitor": {
      "tau_out": "first_time_levels(S_t[O_out], schedule_levels(S_t[O_out], H_out_j))",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K == S_0",
      "H_in < 0.915 * S_0",
      "T == 2",
      "O_out == 'monthly_last'"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * min((S_T - S_0) / S_0, 0))"
        }
      ]
    }
  ]
}
