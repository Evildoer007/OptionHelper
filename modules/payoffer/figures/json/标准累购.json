{
  "name_zh": "标准累购",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "K": 90.0,
    "H_KO": 105.0,
    "q": 100.0,
    "m": 2,
    "Llock": 20,
    "n_obs": 240,
    "O_KO": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "monitor": {
      "tau_out": "first_time(S_t[O_out] >= H_out)",
      "n_out": "observation_ordinal(S_t[O_out], tau_out)",
      "Q_acc": "accumulated_quantity(S_t[O_out], H_out, K, q, m, n_lock, n_obs, T_contract)"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K < H_out",
      "n_lock <= n_obs"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf and n_out <= n_lock",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, 100 * u * Q_acc * (S_T - K) / (q * n_obs * S_0))"
        }
      ]
    },
    {
      "condition": "tau_out < inf and n_out > n_lock",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, 100 * u * Q_acc * (S_T - K) / (q * n_obs * S_0))"
        }
      ]
    },
    {
      "condition": "tau_out == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, 100 * u * Q_acc * (S_T - K) / (q * n_obs * S_0))"
        }
      ]
    }
  ],
  "visual_template": {
    "schema_version": 1,
    "layout": "standard_path_cards",
    "path_views": [
      {
        "path_index": 1,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径1"
      },
      {
        "path_index": 2,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径2"
      },
      {
        "path_index": 3,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径3"
      }
    ]
  }
}
