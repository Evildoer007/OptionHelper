{
  "name_zh": "标准累购",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "K": 90.0,
    "H_KO": 105.0,
    "q": 100.0,
    "m": 2,
    "Llock": 20,
    "n_obs": 240,
    "O_KO": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "monitor": {
      "tau_out": "first_time(S_t[O_out] >= H_out)",
      "n_out": "observation_ordinal(S_t[O_out], tau_out)",
      "Q_acc": "accumulated_quantity(S_t[O_out], H_out, K, q, m, n_lock, n_obs, T)"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K < H_out",
      "n_lock <= n_obs"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf and n_out <= n_lock",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, u * Q_acc * (S_T - K))"
        }
      ]
    },
    {
      "condition": "tau_out < inf and n_out > n_lock",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, u * Q_acc * (S_T - K))"
        }
      ]
    },
    {
      "condition": "tau_out == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, u * Q_acc * (S_T - K))"
        }
      ]
    }
  ]
}
