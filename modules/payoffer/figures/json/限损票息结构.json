{
  "name_zh": "限损票息结构",
  "terms": {
    "S0": 100.0,
    "T": 0.5,
    "N": 10000000.0,
    "g": 0.05,
    "H_KO": 103.0,
    "c": 0.117,
    "O_KO": "monthly_last",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "Lmax": 0.05,
    "Llock": 1,
    "monitor": {
      "tau_out": "first_time_after(S_t[O_out] >= H_out, n_lock)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "H_out == 1.03 * S_0",
      "is_monthly_schedule(O_out)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf",
      "cases": [
        {
          "domain": "S_T >= S_0",
          "pnl": "cash(T, 0)"
        },
        {
          "domain": "(1 - ell) * S_0 <= S_T < S_0",
          "pnl": "cash(T, N * r_T)"
        },
        {
          "domain": "0 <= S_T < (1 - ell) * S_0",
          "pnl": "cash(T, -N * ell)"
        }
      ]
    }
  ]
}
