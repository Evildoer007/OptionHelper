{
  "name_zh": "超低敲入型雪球",
  "terms": {
    "S0": 100.0,
    "T": 2.0,
    "N": 10000000.0,
    "g": 1.0,
    "H_KO": 100.0,
    "H_KI": 65.0,
    "c": 0.077,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "Llock": 3,
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "monitor": {
      "tau_out": "first_time_after(S_t[O_out] >= H_out, n_lock)",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "g == 1",
      "H_in < H_out",
      "is_monthly_schedule(O_out)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * min((S_T - S_0) / S_0, 0))"
        }
      ]
    }
  ]
}
