{
  "name_zh": "折价建仓型雪球",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "N": 10000000.0,
    "g": 0.3,
    "K": 90.0,
    "H_KO": 103.0,
    "H_KI": 70.0,
    "c": 0.32,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "monitor": {
      "tau_out": "first_time(S_t[O_out] >= H_out)",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K < S_0",
      "H_in < H_out"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < tau_in",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_in < inf and tau_in <= tau_out",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * (S_T - K) / K)"
        }
      ]
    }
  ]
}
