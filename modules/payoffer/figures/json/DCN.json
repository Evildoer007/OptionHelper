{
  "name_zh": "DCN",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "N": 10000000.0,
    "g": 0.2,
    "c": 0.01,
    "O_KO": "monthly_last",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "Hc": 80.0,
    "Oc": "monthly_last",
    "Llock": 3,
    "monitor": {
      "tau_out": "first_time_after(S_t[O_out] >= schedule_levels(S_t[O_out], H_out_j), n_lock)",
      "n_coupon": "count_until(S_t[O_c] >= H_c, first_time_after(S_t[O_out] >= schedule_levels(S_t[O_out], H_out_j), n_lock))"
    },
    "derived_terms": {
      "G": "N * g",
      "ko_barrier_schedule": "terminal_schedule(period_count(T, 12), S_0, 1, 0.8)"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "g == 0.2",
      "H_c == 0.8 * S_0",
      "n_lock < period_count(T, 12)",
      "is_monthly_schedule(O_out)",
      "is_monthly_schedule(O_c)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < T",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c * n_coupon)"
        }
      ]
    },
    {
      "condition": "tau_out == T",
      "cases": [
        {
          "domain": "S_T >= H_c",
          "pnl": "cash(T, N * c * n_coupon)"
        }
      ]
    },
    {
      "condition": "tau_out == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * (c * n_coupon + S_T / S_0 - 1))"
        }
      ]
    }
  ],
  "visual_template": {
    "schema": "optionhelper.payoff-visual-template",
    "layout": "standard_path_cards",
    "path_views": [
      {
        "path_index": 1,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径1"
      },
      {
        "path_index": 2,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径2"
      },
      {
        "path_index": 3,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径3"
      }
    ]
  }
}
