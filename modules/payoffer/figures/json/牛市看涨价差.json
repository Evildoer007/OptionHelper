{
  "name_zh": "牛市看涨价差",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "exercise_style": "European",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "K1": 95.0,
    "K2": 105.0,
    "P_net": 4.0,
    "pricing_methods": [
      "analytical",
      "monte_carlo"
    ],
    "constraints": [
      "K_1 < K_2"
    ]
  },
  "paths": [
    {
      "condition": "True",
      "cases": [
        {
          "domain": "0 <= S_T <= K_1",
          "pnl": "cash(0, -P_net)"
        },
        {
          "domain": "K_1 < S_T < K_2",
          "pnl": "cash(0, -P_net) + cash(T, u * (S_T - K_1))"
        },
        {
          "domain": "S_T >= K_2",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_2 - K_1))"
        }
      ]
    }
  ]
}
