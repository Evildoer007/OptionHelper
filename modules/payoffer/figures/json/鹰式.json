{
  "name_zh": "鹰式",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "exercise_style": "European",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "K1": 85.0,
    "K2": 95.0,
    "K3": 105.0,
    "K4": 115.0,
    "P_net": 3.0,
    "pricing_methods": [
      "black_scholes",
      "monte_carlo"
    ],
    "constraints": [
      "K_1 < K_2 and K_2 < K_3 and K_3 < K_4"
    ]
  },
  "paths": [
    {
      "condition": "True",
      "cases": [
        {
          "domain": "0 <= S_T <= K_1",
          "pnl": "cash(0, -P_net)"
        },
        {
          "domain": "K_1 < S_T < K_2",
          "pnl": "cash(0, -P_net) + cash(T, u * (S_T - K_1))"
        },
        {
          "domain": "K_2 <= S_T <= K_3",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_2 - K_1))"
        },
        {
          "domain": "K_3 < S_T < K_4",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_2 + K_3 - K_1 - S_T))"
        },
        {
          "domain": "S_T >= K_4",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_2 + K_3 - K_1 - K_4))"
        }
      ]
    }
  ]
}
