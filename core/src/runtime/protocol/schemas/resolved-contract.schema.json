{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optionhelper://schemas/resolved-contract",
  "title": "ResolvedContract",
  "type": "object",
  "required": ["identity", "terms", "term_sources", "paths", "product_version", "resolved_schedules", "contract_fingerprint", "registry_snapshot_hash", "product_snapshot_hash", "product_paths_hash"],
  "additionalProperties": false,
  "properties": {
    "identity": {"type": "object"},
    "terms": {"type": "object"},
    "term_sources": {"type": "object", "additionalProperties": {"enum": ["default", "override", "derived"]}},
    "paths": {"type": "array", "minItems": 1},
    "product_version": {"type": "string", "minLength": 1},
    "resolved_schedules": {"type": "object"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product_paths_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
