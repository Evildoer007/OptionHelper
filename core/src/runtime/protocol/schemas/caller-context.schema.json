{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optionhelper://schemas/caller-context",
  "title": "CallerContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "principal_id", "role", "capabilities", "session_id", "audience"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "session_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "request_id": {"type": "string"}
  }
}
