{
  "name_zh": "降落伞雪球",
  "terms": {
    "S0": 100.0,
    "T": 2.0,
    "N": 10000000.0,
    "g": 0.2,
    "K": 100.0,
    "H_KO_regular": 103.0,
    "H_KO_final": 70.0,
    "H_KI": 70.0,
    "c": 0.15,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "event_priority": "KO_over_KI",
    "monitor": {
      "tau_out_1": "first_time_before(S_t[O_out] >= H_out_1, T)",
      "tau_out_2": "terminal_event_time(S_t[O_out] >= H_out_2, T_contract)",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K == S_0",
      "H_out_2 == H_in",
      "H_out_2 < H_out_1"
    ]
  },
  "paths": [
    {
      "condition": "tau_out_1 < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out_1, N * c * tau_out_1)"
        }
      ]
    },
    {
      "condition": "tau_out_1 == inf and tau_out_2 < inf",
      "cases": [
        {
          "domain": "S_T >= H_out_2",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out_1 == inf and tau_out_2 == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c * T)"
        }
      ]
    },
    {
      "condition": "tau_out_1 == inf and tau_out_2 == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * min((S_T - S_0) / S_0, 0))"
        }
      ]
    }
  ]
}
