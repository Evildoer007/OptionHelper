{
  "name_zh": "看涨期权",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "exercise_style": "European",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "K": 100.0,
    "Pi_0": 5.0,
    "n_C": 1.0,
    "pricing_methods": [
      "analytical",
      "monte_carlo"
    ]
  },
  "paths": [
    {
      "condition": "True",
      "cases": [
        {
          "domain": "0 <= S_T <= K",
          "pnl": "cash(0, -n_C * P)"
        },
        {
          "domain": "S_T > K",
          "pnl": "cash(0, -n_C * P) + cash(T, u * n_C * (S_T - K))"
        }
      ]
    }
  ]
}
