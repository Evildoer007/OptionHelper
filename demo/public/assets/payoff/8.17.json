{
  "name_zh": "全保证金型小雪球（无敲入）",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "N": 100000000.0,
    "g": 1.0,
    "H_KO": 103.0,
    "O_KO": "monthly_last",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "c1": 0.065,
    "c2": 0.0055,
    "monitor": {
      "tau_out": "first_time(S_t[O_out] >= H_out)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "g == 1",
      "H_out == 1.03 * S_0",
      "c_1 == 0.065",
      "c_2 == 0.0055"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * c_1 * tau_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * c_2 * T)"
        }
      ]
    }
  ]
}
