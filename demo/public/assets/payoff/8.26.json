{
  "name_zh": "触发器",
  "terms": {
    "S0": 100.0,
    "T": 0.5,
    "N": 2400000.0,
    "g": 0.3,
    "K": 100.0,
    "H_KO": 103.0,
    "H_KI": 80.0,
    "O_KO": "monthly_last",
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "r_out": 0.08,
    "r_mat": 0.08,
    "monitor": {
      "tau_out": "first_time(S_t[O_out] >= H_out)",
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "monte_carlo"
    ],
    "constraints": [
      "K == S_0",
      "H_in < H_out",
      "is_monthly_schedule(O_out)"
    ]
  },
  "paths": [
    {
      "condition": "tau_out < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(tau_out, N * r_out)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in == inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(T, N * r_mat)"
        }
      ]
    },
    {
      "condition": "tau_out == inf and tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= K",
          "pnl": "cash(T, 0)"
        },
        {
          "domain": "0 <= S_T < K",
          "pnl": "cash(T, N * (S_T / K - 1))"
        }
      ]
    }
  ]
}
