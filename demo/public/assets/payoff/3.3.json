{
  "name_zh": "蝶式",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "exercise_style": "European",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "K1": 90.0,
    "K2": 100.0,
    "K3": 110.0,
    "P_net": 2.5,
    "pricing_methods": [
      "analytical",
      "monte_carlo"
    ],
    "constraints": [
      "K_1 < K_2 and K_2 < K_3",
      "2 * K_2 == K_1 + K_3"
    ]
  },
  "paths": [
    {
      "condition": "True",
      "cases": [
        {
          "domain": "0 <= S_T <= K_1",
          "pnl": "cash(0, -P_net)"
        },
        {
          "domain": "K_1 < S_T <= K_2",
          "pnl": "cash(0, -P_net) + cash(T, u * (S_T - K_1))"
        },
        {
          "domain": "K_2 < S_T < K_3",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_3 - S_T))"
        },
        {
          "domain": "S_T >= K_3",
          "pnl": "cash(0, -P_net)"
        }
      ]
    }
  ]
}
