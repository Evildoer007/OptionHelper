{
  "name_zh": "宽跨式",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "exercise_style": "European",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": false,
    "Kp": 90.0,
    "Kc": 110.0,
    "P_net": 8.0,
    "pricing_methods": [
      "analytical",
      "monte_carlo"
    ],
    "constraints": [
      "K_1 < K_2"
    ]
  },
  "paths": [
    {
      "condition": "True",
      "cases": [
        {
          "domain": "0 <= S_T < K_1",
          "pnl": "cash(0, -P_net) + cash(T, u * (K_1 - S_T))"
        },
        {
          "domain": "K_1 <= S_T <= K_2",
          "pnl": "cash(0, -P_net)"
        },
        {
          "domain": "S_T > K_2",
          "pnl": "cash(0, -P_net) + cash(T, u * (S_T - K_2))"
        }
      ]
    }
  ]
}
