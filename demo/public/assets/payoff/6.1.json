{
  "name_zh": "标准安全气囊Airbag",
  "terms": {
    "S0": 100.0,
    "T": 1.0,
    "N": 100.0,
    "B": 80.0,
    "g": 0.3,
    "p": 0.05,
    "O_KI": "daily",
    "settlement": "cash",
    "observation_price": "close",
    "margin_call": true,
    "monitor": {
      "tau_in": "first_time(S_t[O_in] <= H_in)"
    },
    "derived_terms": {
      "G": "N * g"
    },
    "pricing_methods": [
      "analytical",
      "monte_carlo"
    ]
  },
  "paths": [
    {
      "condition": "tau_in < inf",
      "cases": [
        {
          "domain": "S_T >= 0",
          "pnl": "cash(0, -N * p) + cash(T, N * r_T)"
        }
      ]
    },
    {
      "condition": "tau_in == inf",
      "cases": [
        {
          "domain": "r_T > 0",
          "pnl": "cash(0, -N * p) + cash(T, N * r_T)"
        },
        {
          "domain": "r_T <= 0",
          "pnl": "cash(0, -N * p)"
        }
      ]
    }
  ],
  "visual_template": {
    "schema": "optionhelper.payoff-visual-template",
    "layout": "standard_path_cards",
    "path_views": [
      {
        "path_index": 1,
        "case_indexes": [
          1
        ],
        "axis": "S_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径1"
      },
      {
        "path_index": 2,
        "case_indexes": [
          1,
          2
        ],
        "axis": "r_T",
        "chart_kind": "conditional_terminal_metric",
        "title": "路径2"
      }
    ]
  }
}
